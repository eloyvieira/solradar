# ARBITRAGE 
ARBITRAGE_MIN_LIQUIDITY_USD=20000
ARBITRAGE_MIN_SPREAD_PCT=0.5
SECURITY_SCAN_SECONDS=60
SECURITY_RPC_SPACING_MS=200
MAX_SIGNAL_AGE_SECONDS=30
POSITION_POLL_SECONDS=5
TRAILING_STOP_PCT=5

# ARBITRAGE EXECUTOR
ARBITRAGE_LIVE_ENABLED=false
ARBITRAGE_TRADE_AMOUNT_USD=1000
ARBITRAGE_MIN_NET_PROFIT_USD=1

# JUPITER
# liquidity aggregator (DEX aggregator) on the Solana network.
JUPITER_API_KEY=jup...

# MYSQL 
DATABASE_URL=mysql://CHANGE_USER:CHANGE_PASS@host.docker.internal:3306/CHANGE_DB

# PUMP 
PUMP_MIN_ACCEL=2
PUMP_MIN_CHANGE_PCT=2
PUMP_MIN_BUY_RATIO=0.6
PUMP_MIN_LIQUIDITY_USD=100000
PUMP_MIN_VOLUME_M5_USD=10000

# RABBITMQ 
RABBITMQ_USER=CHANGE_USER
RABBITMQ_PASSWORD=CHANGE_PASS
AMQP_URL=amqp://CHANGE_USER:CHANGE_PASS@rabbitmq:5672/%2f

# SOLANA 
SOLANA_RPC_URL=https://api.mainnet.solana.com
POOL_FEES_UPDATE_SECONDS=1800
POOL_FEES_RPC_SPACING_MS=1500
NETWORK_FEES_UPDATE_SECONDS=300
MIN_VOLUME_H24_USD=300000
MIN_LIQUIDITY_USD=50000
MAX_PAGES=4
SCAN_INTERVAL_SECONDS=60
REQUEST_SPACING_SECONDS=15

# SOLANA WALLET
SOLANA_KEYPAIR_PATH=/run/secrets/solana-wallet.json